# Скопируйте этот файл в .env и вставьте свои ключи после знака "=".
# Пустой ключ = этот источник просто не используется.

# 2ГИС: поиск компаний (https://platform.2gis.ru)
DGIS_API_KEY=

# Яндекс: API Поиска по организациям (https://developer.tech.yandex.ru)
YANDEX_MAPS_API_KEY=

# DaData: директор и ИНН по названию компании (https://dadata.ru/profile/#info)
DADATA_API_KEY=

# Claude: персональные сообщения и разбор сайта (https://platform.claude.com)
ANTHROPIC_API_KEY=
